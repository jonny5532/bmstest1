# Writes the build's identity to OUT (a C header), run on every build:
#
#   cmake -DSRC=<repo> -DOUT=<header> -P firmware_id.cmake
#
# BMS_BUILD_HASH is the commit's first 7 hex digits, with bit 31 set when tracked files differ
# from that commit (a local, uncommitted build). BMS_BUILD_TIME is when this build ran (Unix
# seconds, UTC). Without git both are 0.

find_package(Git QUIET)
set(git_args)

# Building in WSL from a Windows checkout: use Windows' line-ending setting, or every file
# looks modified, and follow a git worktree's Windows-style gitdir path (C:/... -> /mnt/c/...).
if(DEFINED ENV{WSL_DISTRO_NAME})
    list(APPEND git_args -c core.autocrlf=true)
    if(EXISTS ${SRC}/.git AND NOT IS_DIRECTORY ${SRC}/.git)
        file(READ ${SRC}/.git dotgit)
        if(dotgit MATCHES "gitdir: ([A-Za-z]):/([^\r\n]*)")
            string(TOLOWER "${CMAKE_MATCH_1}" drive)
            list(APPEND git_args --git-dir=/mnt/${drive}/${CMAKE_MATCH_2} --work-tree=${SRC})
        endif()
    endif()
endif()

set(hash "0")
set(dirty 0)
set(describe "unknown")
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} ${git_args} rev-parse --short=7 HEAD
        WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE git_hash RESULT_VARIABLE rc
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND git_hash MATCHES "^[0-9a-f]+$")
        string(SUBSTRING "${git_hash}" 0 7 git_hash)
        set(hash "0x${git_hash}")
        set(describe "${git_hash}")
        execute_process(COMMAND ${GIT_EXECUTABLE} ${git_args} diff --quiet HEAD --
            WORKING_DIRECTORY ${SRC} RESULT_VARIABLE diff_rc OUTPUT_QUIET ERROR_QUIET)
        if(NOT diff_rc EQUAL 0)
            set(dirty 1)
            set(describe "${describe}-dirty")
        endif()
    endif()
endif()
string(TIMESTAMP build_time "%s" UTC)
string(TIMESTAMP build_text "%Y-%m-%d %H:%M UTC" UTC)

set(content "// Generated by cmake/firmware_id.cmake on every build. Do not edit.
#define BMS_BUILD_HASH (${hash}u | (${dirty}u << 31))
#define BMS_BUILD_TIME ${build_time}u
#define BMS_BUILD_DESCRIBE \"${describe}\"
#define BMS_BUILD_TIME_TEXT \"${build_text}\"
")

# Only touch the header when something changed (the time does on every build).
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT "${old}" STREQUAL "${content}")
    file(WRITE ${OUT} "${content}")
endif()
